# Ads Business OS — biến môi trường. KHÔNG commit file .env thật.
ADSOS_APP_ENV=local

# Database (ADSOS_DATABASE_URL)
# - Local/test: để trống → SQLite file ./adsos.db (mặc định).
# - Production Turso/libSQL (D-066): cài requirements-turso.txt, rồi:
#     ADSOS_DATABASE_URL=sqlite+libsql://<db>-<org>.turso.io/?authToken=<token>&secure=true
# - Hoặc Postgres (vẫn hỗ trợ): postgresql+psycopg://adsos:adsos@localhost:5432/adsos
ADSOS_DATABASE_URL=sqlite+libsql://your-db-your-org.turso.io/?authToken=REPLACE_ME&secure=true

# Meta Marketing API (token chỉ đọc hoặc write có kiểm soát)
ADSOS_META_ACCESS_TOKEN=
# Token theo nguồn (JSON): {"<bm_id|act_id>": "<token>"} — fallback về ADSOS_META_ACCESS_TOKEN
ADSOS_META_TOKEN_MAP=
# Meta OAuth 2.0 chính thức cho VIA (App Secret chỉ cấu hình ở backend)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Redirect URI phải là DOMAIN BACKEND và BẮT BUỘC HTTPS khi deploy (app Business của Meta không
# còn miễn trừ http://localhost). Deploy: https://api.vextech.vn/api/v1/oauth/facebook/callback
# — trùng khít với Valid OAuth Redirect URIs trong App Facebook. Local không cert: giữ 127.0.0.1.
FACEBOOK_REDIRECT_URI=http://127.0.0.1:8000/api/v1/oauth/facebook/callback
# Hạn mức ngân sách ngày tối đa cho campaign tạo mới qua bot/pipeline (VND, mặc định 50 triệu)
ADSOS_META_MAX_DAILY_BUDGET=50000000
# Chỉ bật sau khi đã phê duyệt luồng ghi Meta và audit log
ADSOS_META_WRITES_ENABLED=0

# metaOs Extension server (để trống khi chạy local; backend dùng origin của request)
ADSOS_EXTENSION_PUBLIC_BASE_URL=
# Tích hợp tùy chọn cho chức năng AI của extension; thiếu cấu hình sẽ trả 503, không giả lập
ADSOS_AI_API_URL=
ADSOS_AI_API_KEY=
ADSOS_AI_MODEL=
# Webhook Zalo tùy chọn; token chỉ đặt trong env
ADSOS_ZALO_NOTIFY_URL=
ADSOS_ZALO_NOTIFY_TOKEN=

# Google Sheets (spreadsheet id; service account JSON đặt ngoài repo, trỏ đường dẫn nếu app cần)
ADSOS_GOOGLE_SHEETS_SPREADSHEET_ID=
# Access token chi doc (scope sheets.readonly) - neu khong dung service account
ADSOS_GOOGLE_SHEETS_ACCESS_TOKEN=
# Service account google-auth: tro den file JSON (dat NGOAI repo, quyen Viewer; tu refresh token ~1h)
ADSOS_GOOGLE_SERVICE_ACCOUNT_FILE="C:\secrets\adsos-sa.json"
GOOGLE_APPLICATION_CREDENTIALS=

# Telegram Bot (quản trị + báo cáo + điều khiển campaign có kiểm soát)
# Chế độ: Polling tự động khi ENV=development/local, Webhook khi ENV=production
ADSOS_TELEGRAM_BOT_TOKEN=
# Chat ID admin nhận thông báo (số dương cho user, -100... cho group/channel)
ADSOS_TELEGRAM_ADMIN_CHAT_ID=
# Danh sách chat ID được phép tương tác điều khiển bot (phân tách bởi dấu phẩy)
ADSOS_TELEGRAM_ALLOWED_CHAT_IDS=
# Webhook secret (tùy chọn) khi chạy production
ADSOS_TELEGRAM_WEBHOOK_SECRET=

# AI Copilot & LLM Orchestrator
# LLM_PROVIDER: "gemini" hoặc "ollama" (mặc định gemini)
LLM_PROVIDER=gemini
# Nếu dùng Gemini API: điền API key lấy từ Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Nếu dùng Ollama Local: khởi động ollama serve (mặc định http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Scheduler S4: bật/tắt job hằng giờ + checkpoint 09:00 (0 = tắt cho test/dev)
ADSOS_SCHEDULER_ENABLED=1
# Cửa sổ grace cho checkpoint 09:00 (phút) — xem Q-013 trong docs/DECISIONS.md
ADSOS_CHECKPOINT_GRACE_MINUTES=15

# TRON (ví chung USDT TRC20)
ADSOS_TRON_WALLET_ADDRESS=
# Exchange (Binance Spot + Funding USDT & PingPong) - xem docs/BINANCE_CONNECTION.md
# Master key de ma hoa Fernet API Key/Secret cua san (32-byte Fernet base64, bat buoc khi luu credentials)
ADSOS_EXCHANGE_MASTER_KEY=
# Ma quan tri truy cap trang vi tren UI (it nhat 32 ky tu, bat buoc)
ADSOS_EXCHANGE_ADMIN_TOKEN=
# Origins duoc phep (CORS + OAuth callback redirect ve frontend). Them domain Vercel khi deploy:
#   ADSOS_EXCHANGE_UI_ORIGINS=https://ads.vextech.vn
# (mac dinh http://localhost:3000,http://127.0.0.1:3000 cho local)
ADSOS_EXCHANGE_UI_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Scheduler tu dong cap nhat so du san (0 = tat, 1 = bat)
ADSOS_EXCHANGE_SCHEDULER_ENABLED=0

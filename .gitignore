# Hồ sơ Chrome và dữ liệu tạm chỉ dành cho nghiệm thu giao diện local
artifacts/ui-refactor/chrome-profile/
.test-admin-ui-*/
.test-admin-ui-*.log

# Rác output của agent/CI — không commit (log, dump test/build, lock SQLite tạm, file .tmp)
*.log
*.tmp
.review-*/
.test-*/
.test-*.log
apps/api/adsos.db*.lock
apps/api/pytest_*.txt
apps/api/test_output.txt
build-*.txt
build_out.txt
tsc_out.txt
db_check.txt

# Chứng chỉ dev HTTPS local (nếu dùng cert tự ký) — KHÔNG commit
*-dev-cert.pem
*-dev-key.pem

# Env deploy production/staging — chỉ giữ file .example
apps/web/.env.local
apps/web/.env.production
apps/web/.env.production.local

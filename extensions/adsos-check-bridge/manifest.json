{
    "name": "metaOs",
    "version": "2.2.5",
    "manifest_version": 3,
    "description": "metaOs — Công cụ hỗ trợ quản lý tài khoản và quảng cáo Meta",
    "homepage_url": "http://127.0.0.1:8000/metaos",
    "icons": {
        "16": "img/icon-16.png",
        "48": "img/icon-48.png",
        "128": "img/icon-128.png"
    },
    "action": {
        "default_title": "metaOs",
        "default_icon": {
            "16": "img/icon-16.png",
            "48": "img/icon-48.png",
            "128": "img/icon-128.png"
        }
    },
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self'; frame-src http://localhost:* http://127.0.0.1:*"
    },
    "content_scripts": [
        {
            "js": [
                "js/content.js"
            ],
            "css": [
                "css/smile.css"
            ],
            "matches": [
                "<all_urls>"
            ],
            "run_at": "document_start",
            "all_frames": true
        },
        {
            "js": [
                "js/login.js"
            ],
            "matches": [
                "<all_urls>"
            ]
        },
        {
            "js": [
                "js/fb-opt-main.js"
            ],
            "world": "MAIN",
            "matches": [
                "*://*.facebook.com/*",
                "*://*.messenger.com/*"
            ],
            "run_at": "document_start",
            "all_frames": true
        },
        {
            "js": [
                "js/fb-opt-relay.js"
            ],
            "matches": [
                "*://*.facebook.com/*",
                "*://*.messenger.com/*"
            ],
            "run_at": "document_start",
            "all_frames": true
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "js/bridge-main.js",
                "img/icon-48.png",
                "img/icon-16.png",
                "img/icon-128.png"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ],
    "background": {
        "service_worker": "js/background.js"
    },
    "permissions": [
        "tabs",
        "cookies",
        "activeTab",
        "storage",
        "unlimitedStorage",
        "scripting",
        "alarms",
        "offscreen",
        "declarativeNetRequest",
        "declarativeNetRequestWithHostAccess",
        "proxy",
        "webRequest",
        "webRequestAuthProvider"
    ],
    "host_permissions": [
        "<all_urls>"
    ]
}
